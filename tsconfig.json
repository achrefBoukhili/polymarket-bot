{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    // Unfinished, unregistered WIP: references an undeclared `client` field
    // and imports `ethers`, which is not a dependency. Excluded so the build
    // works; delete this line once it is finished and registered.
    "src/strategies/market_making/enhanced_liniar_invantory_V2.ts"
  ]
}
